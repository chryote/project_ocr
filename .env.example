# Application Environment
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Tesseract OCR Engine Configuration
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Path to tessdata directory containing traineddata files (defaults to ./tessdata)
TESSDATA_PREFIX=./tessdata

# Primary and fallback languages (e.g. ind+eng or eng)
OCR_LANG=ind+eng
OCR_FALLBACK_LANG=eng

# Tesseract Page Segmentation Mode (PSM) and OCR Engine Mode (OEM)
OCR_PSM=6
OCR_OEM=3
OCR_TIMEOUT_SECONDS=15

# Image Preprocessing Settings
PREPROCESSING_ENABLED=true
DESKEW_ENABLED=true
TARGET_DPI_WIDTH=1200
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_SIZE=8

# Hotel Business Rules
MIN_ADULT_AGE=18
REQUIRE_16_DIGIT_NIK=true

# Request Upload Limitations
MAX_UPLOAD_SIZE_MB=10
